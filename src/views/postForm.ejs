<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - <%= post ? 'Editar Post' : 'Nuevo Post' %></title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body class="grey lighten-4">
  <div class="candy-decor">
    <span>🍭</span>
    <span>🍬</span>
    <span>☁️</span>
    <span>🍡</span>
    <span>🍩</span>
    <span>🧁</span>
    <span>🍫</span>
    <span>🍥</span>
    <span>🍪</span>
    <span>🍨</span>
    <span>🎂</span>
    <span>🍦</span>
    <span>🍮</span>
    <span>☁️</span>
  </div>

  <nav>
    <div class="nav-wrapper teal">
      <a href="#!" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px; max-width: 600px;">
    <h4 class="center-align" style="color: #FF5FA2;"><%= post ? 'Editar Post' : 'Nuevo Post' %></h4>

    <div class="candy-form-card">
      <form action="<%= post ? '/posts/edit/' + post._id : '/posts/new' %>" method="POST">

        <% if (!post) { %>
        <div class="input-field">
          <select name="userId" required>
            <option value="" disabled selected>Selecciona un usuario</option>
            <% users.forEach(u => { %>
              <option value="<%= u._id %>"><%= u.name %> <%= u.lastName %></option>
            <% }) %>
          </select>
          <label>Usuario</label>
        </div>
        <% } %>

        <div class="input-field">
          <input type="text" name="title" id="title" value="<%= post ? post.title : '' %>" minlength="5" maxlength="30" required>
          <label for="title" class="<%= post ? 'active' : '' %>">Título</label>
        </div>

        <div class="input-field">
          <textarea name="content" id="content" class="materialize-textarea" minlength="10" required><%= post ? post.content : '' %></textarea>
          <label for="content" class="<%= post ? 'active' : '' %>">Contenido</label>
        </div>

        <div class="input-field">
          <input type="text" name="hashtags" id="hashtags" value="<%= post ? (post.hashtags || []).join(', ') : '' %>">
          <label for="hashtags" class="<%= post ? 'active' : '' %>">Hashtags (separados por coma)</label>
        </div>

        <div class="input-field">
          <input type="text" name="imageUrl" id="imageUrl" value="<%= post ? post.imageUrl || '' : '' %>">
          <label for="imageUrl" class="<%= post ? 'active' : '' %>">URL de imagen</label>
        </div>

        <div class="center-align" style="margin-top: 20px;">
          <button type="submit" class="btn waves-effect waves-light teal">
            <%= post ? 'Guardar cambios' : 'Publicar' %>
          </button>
          <a href="/posts" class="btn-flat">Cancelar</a>
        </div>

      </form>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var selects = document.querySelectorAll("select");
      M.FormSelect.init(selects);
    });
  </script>
</body>
</html>