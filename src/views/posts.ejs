<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - Posts</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body class="grey lighten-4">
  <div class="candy-decor">
    <span>🍭</span>
    <span>🍬</span>
    <span>☁️</span>
    <span>🍡</span>
    <span>🍩</span>
    <span>🧁</span>
    <span>🍫</span>
    <span>🍥</span>
    <span>🍪</span>
    <span>🍨</span>
    <span>🎂</span>
    <span>🍦</span>
    <span>🍮</span>
    <span>☁️</span>
  </div>

  <nav>
    <div class="nav-wrapper teal">
      <a href="#!" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container">
    <h4 class="center-align">Bienvenido a Social Media</h4>

    <div class="row" style="margin-top: 20px;">
      <div class="col s12 right-align">
        <a href="/posts/new" class="btn waves-effect waves-light green">
          <i class="material-icons left">add</i> Nuevo Post
        </a>
      </div>
    </div>

    <div class="row">
      <% posts.forEach(post => { %>
      <div class="col s12 m6 l4">
        <div class="card">
          <div class="card-image">
            <img src="<%= post.imageUrl || 'https://media.istockphoto.com/id/627795510/photo/example.jpg?s=612x612&w=0&k=20&c=lpUf5rjPVd6Kl_M6heqC8sUncR4FLmtsRzeYdTr5X_I=' %>" alt="Imagen del post">
          </div>
          <div class="card-content">
            <span class="card-title"><%= post.title %></span>
            <p><%= post.content %></p>
            <p>
              <strong>Hashtags:</strong>
              <% (post.hashtags || []).forEach(tag => { %>
                <span class="chip">#<%= tag %></span>
              <% }) %>
            </p>
          </div>
          <div class="card-action">
            <div class="right">
              <a href="/posts/edit/<%= post._id %>" class="btn-flat">
                <i class="material-icons" style="color: #FF5FA2;">edit</i>
              </a>
              <form action="/posts/delete/<%= post._id %>" method="POST" style="display:inline;" onsubmit="return confirm('¿Seguro que quieres eliminar este post?');">
                <button type="submit" class="btn-flat" style="background:none; border:none;">
                  <i class="material-icons red-text">delete</i>
                </button>
              </form>
            </div>
            <span><strong>Autor:</strong> <%= post.user ? post.user.name + ' ' + post.user.lastName : 'Desconocido' %></span>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>